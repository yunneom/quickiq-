{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "icn1"
  ],
  "headers": [
    {
      "source": "/api/webhooks/lemon-squeezy",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/ig-post",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/ig-post",
      "schedule": "0 12 * * *"
    }
  ]
}
